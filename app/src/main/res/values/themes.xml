<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BrainRacer" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Системный SplashScreen (androidx.core.splashscreen). MainActivity вызывает
      installSplashScreen() ДО super.onCreate(), поэтому activity-тема в манифесте
      должна быть Theme.SplashScreen-наследником, а постфактум библиотека сама
      переключит тему на postSplashScreenTheme = Theme.BrainRacer.
    -->
    <style name="Theme.BrainRacer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_inset</item>
        <item name="postSplashScreenTheme">@style/Theme.BrainRacer</item>
    </style>
</resources>
