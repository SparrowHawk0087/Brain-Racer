rules_version = '2';
// Скопируйте в Firebase Console → Storage → Rules или подключите через firebase.json ("storage": { "rules": "storage.rules" }).
// Пути приложения: avatars/{uid}, quiz_covers/{uid}, quiz_images/{uid} (см. ProfileViewModel, QuizCreatorViewModel).
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{file} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if true;
    }
    match /quiz_covers/{userId}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /quiz_images/{userId}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
